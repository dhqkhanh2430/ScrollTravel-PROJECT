             <height>50</height>
            </size>
           </property>
           <property name="styleSheet">
            <string notr="true">/* --- TRẠNG THÁI BÌNH THƯỜNG --- */
QPushButton {
    background-color: #2980b9; /* Màu xanh dương (Màu nền chính) */
    color: white;              /* Màu chữ */
    font-weight: bold;         /* Chữ đậm */
    font-size: 8px;           /* Cỡ chữ */
    border-radius: 10px;       /* Bo tròn góc */
    padding: 10px;             /* Khoảng cách đệm để nút to ra */
    border: none;              /* Xóa viền xấu xí mặc định */
	margin-top: 8px;
	margin-bottom: 20px;
}

/* --- KHI DI CHUỘT VÀO (HOVER) --- */
QPushButton:hover {
    background-color: #3498db; /* Đổi sang màu xanh sáng hơn */
}

/* --- KHI BẤM GIỮ CHUỘT (PRESSED) --- */
QPushButton:pressed {
    background-color: #1f618d; /* Đổi sang màu tối hơn (cảm giác nút lún xuống) */
    padding-top: 12px;         /* (Mẹo) Dịch chữ xuống 1 xíu tạo cảm giác nhấn thật */
    padding-left: 12px;
}</string>
           </property>
