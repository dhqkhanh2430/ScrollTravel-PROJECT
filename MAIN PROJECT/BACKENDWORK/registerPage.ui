           <property name="styleSheet">
            <string notr="true">QLineEdit {
    border: 1px solid #555555; /* Viền màu xám, dày 2px */
    border-radius: 10px;       /* Độ bo tròn (số càng lớn càng tròn) */
    padding-left: 10px;        /* Đệm trái để chữ không sát mép */
    padding-right: 10px;       /* Đệm phải */
    background-color:  #e0ffff ; /* Màu nền */
    color: black;              /* Màu chữ */
	padding: 12px;

}

/* Hiệu ứng khi bấm chuột vào */
QLineEdit:focus {
    border: 1px solid #00aaff; /* Đổi màu viền sang xanh dương */
}

</string>
