         </item>
         <item>
          <widget class="QPushButton" name="toLoginBt">
           <property name="styleSheet">
            <string notr="true">/* Trạng thái bình thường: Trong suốt, không viền */
QPushButton {
    background-color: transparent; /* Nền trong suốt */
    border: none;                  /* Bỏ viền */
    color: #3498db;                /* Màu xanh link (giống web) */
    font-size: 14px;
    text-align: left;              /* Canh trái (hoặc center tùy bạn) */
}

/* Khi di chuột vào: Gạch chân và đổi màu đậm hơn */
QPushButton:hover {
    color: #1d72b8;                /* Xanh đậm hơn */
    text-decoration: underline;    /* Gạch chân (đây là mấu chốt) */
}

/* Khi bấm xuống */
QPushButton:pressed {
    color: #155a8a;
}</string>
