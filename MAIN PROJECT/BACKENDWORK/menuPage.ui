    min-width: 80px;    
}
 QPushButton#filterBtn:hover {
    background-color: #e6e6e6;
    border-color: #bcbcbc;
}


QPushButton#filterBtn:checked {
    background-color: #00aaff;   
    color: white;                
    border: 1px solid #00aaff;
    font-weight: bold;
}


QPushButton#filterBtn:pressed {
    background-color: #0088cc;
}</string>
