          <widget class="QLabel" name="label">
           <property name="styleSheet">
            <string notr="true">/* Trạng thái bình thường: Trong suốt, không viền */
QLabel {
    background-color: transparent; /* Nền trong suốt */
    border: none;                  /* Bỏ viền */
    color: #d3d3d3;                /* Màu xanh link (giống web) */
    font-size: 14px;
    text-align: left;              /* Canh trái (hoặc center tùy bạn) */
}
</string>
